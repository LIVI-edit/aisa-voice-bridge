          "$ref": "#/definitions/AudioStats"
        },
        "review_required": {
          "type": "boolean"
        },
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "scenario_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "scenario_variant_label": {
          "anyOf": [
