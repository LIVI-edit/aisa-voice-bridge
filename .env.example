# Offline storage / policy
AISA_VOICE_DB_PATH=./data/aisa-voice.sqlite
AISA_PILOT_POLICY_PATH=./config/pilot-policy.example.json
REAL_CALLS_ENABLED=false
PRODUCTION_CALLING_POLICY_ID=

# Provider-neutral telephony. Configure only after provider/manual approval.
ASTERISK_OUTBOUND_ENDPOINT=
DIAL_NUMBER_FORMAT=e164
OUTBOUND_CALLER_ID=
TELEPHONY_APPROVAL_REF=
ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USER=
ASTERISK_ARI_PASSWORD=
RTP_BIND_ADDRESS=127.0.0.1
RTP_PAYLOAD_TYPE=0

# OpenAI server-side only. Offline commands do not require this.
OPENAI_API_KEY=
OPENAI_VOICE=
POST_CALL_MODEL=gpt-4o-mini-2024-07-18
